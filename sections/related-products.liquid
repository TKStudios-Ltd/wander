{%- liquid
  assign enable_tabs = section.settings.enable_tabs
  assign type_style = section.settings.type_style
  assign tab_heading_size = section.settings.tab_heading_size | times: 0.01
  assign bg_color = section.settings.bg_color
  assign section_width = section.settings.width
  assign columns_mobile = section.settings.columns_mobile | plus: 0
  assign swym_enabled = section.settings.swym_enabled

  comment
    Filter: a recommended product is shown if it uses the chosen template suffix
    (e.g. "general" = product.general.json) OR has the chosen product type.
    Leave both blank to show everything.
  endcomment
  assign filter_template = section.settings.filter_template_suffix | strip | downcase
  assign filter_type = section.settings.filter_product_type | strip | downcase

  comment
    Shopify returns at most 10 recommendations. We always fetch the maximum so
    there is enough left to fill the grid after filtering.
  endcomment
  assign fetch_limit = 10
  assign fallback_collection = section.settings.fallback_collection

  assign columns = settings.products_per_row_on_desktop
  assign animations_enabled = settings.animations_enabled

  assign section_id = 'relatedProducts--' | append: section.id
  assign related_id = section_id | append: '--' | append: 'productsList'
  assign selector_id = '#' | append: section_id
  assign animation_anchor = selector_id
  assign animation_delay = 150

  assign related_block = section.blocks | map: 'type' | where: 'related'
  assign recent_block = section.blocks | map: 'type' | where: 'recent'

  assign show_tabs = false
  if enable_tabs and related_block != blank and recent_block != blank
    assign show_tabs = true
  endif

  capture type_adjustment
    case type_style
      when 'font-heading'
        echo 'var(--adjust-heading)'
      when 'font-body'
        echo 'var(--adjust-body)'
      when 'subheading-text'
        echo 'var(--adjust-accent)'
    endcase
  endcapture
-%}

{%- style -%}
  {{ selector_id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
  }
  {{ selector_id }} .tabs__nav { --text-size: calc({{ type_adjustment }} * {{ tab_heading_size }}); }

  {%- if bg_color != 'rgba(0,0,0,0)' and bg_color != '' -%}
    {{ selector_id }} { background-color: {{ bg_color }}; }
    {{ selector_id }} .product-grid-item { --bg: {{ bg_color }}; }
  {%- endif -%}

  /* ---------- Related grid (mirrors Collection 4 Tiles) ---------- */
  {{ selector_id }} .related-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 20px;
    justify-content: center;
  }
  {{ selector_id }} .related-grid > * {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  /* Desktop (1200px+): 3 across */
  {{ selector_id }} .related-grid > * { flex: 0 0 calc(33.333% - 13.34px); }

  /* iPad landscape (1024–1199px): 2 across, 3rd hidden */
  @media (min-width: 1024px) and (max-width: 1199px) {
    {{ selector_id }} .related-grid > * { flex: 0 0 calc(50% - 10px); }
    {{ selector_id }} .related-grid > :nth-child(n+3) { display: none; }
  }

  /* iPad Pro 13" landscape (up to 1366px, touch only): 2 across, 3rd hidden */
  @media (min-width: 1200px) and (max-width: 1366px) and (pointer: coarse) and (orientation: landscape) {
    {{ selector_id }} .related-grid > * { flex: 0 0 calc(50% - 10px); }
    {{ selector_id }} .related-grid > :nth-child(n+3) { display: none; }
  }

  /* iPad portrait (744–1023px, plus iPad Pro 13" portrait at 1024px): 2 stacked */
  @media (min-width: 744px) and (max-width: 1023px),
         (min-width: 1024px) and (max-width: 1199px) and (orientation: portrait) {
    {{ selector_id }} .related-grid > * {
      flex: 0 0 100%;
      max-width: {{ section.settings.stacked_max_width }}px;
    }
    {{ selector_id }} .related-grid > :nth-child(n+3) { display: none; }
  }

  /* Mobile (up to 743px): 3 stacked */
  @media (max-width: 743px) {
    {{ selector_id }} .related-grid { padding: 20px 0; }
    {{ selector_id }} .related-grid > * { flex: 0 0 100%; }
  }

  {%- comment -%} Recently viewed carousel (unchanged) {%- endcomment -%}
  @media screen and (max-width: 767px) {
    {%- if columns_mobile > 1 -%}
      {{ selector_id }} .carousel--mobile { --item-width-mobile: calc(90% / {{ columns_mobile }} - var(--grid-gutter)); }
    {%- endif -%}
  }
{%- endstyle -%}

<div id="{{ section_id }}"
  class="related-products section-padding js-only"
  data-section-type="related-products"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-columns="{{ columns }}"
  {% if related_block != blank %}
    data-limit="{{ fetch_limit }}"
  {% endif %}
>
  <div class="{{ section_width }}">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign block_heading = block.settings.title
          assign display_limit = block.settings.product_recommendations_limit | default: 3
          assign product_recently_limit = block.settings.product_recently_limit
        -%}

        {%- capture headings_markup -%}
          {%- if block_heading != blank and show_tabs != true -%}
            <div class="section__header">
              <h2 class="section__heading h3"
                {% if animations_enabled %}
                  data-aos="fade-up"
                  data-aos-delay="{{ animation_delay }}"
                  data-aos-anchor="{{ animation_anchor }}"
                  {%- assign animation_delay = animation_delay | plus: 150 -%}
                {% endif %}
              >
                {{- block_heading -}}
              </h2>

              {%- if settings.show_spacer_lines -%}
                <hr class="section__heading-line"
                  {% if animations_enabled %}
                    data-aos="fade-up"
                    data-aos-delay="{{ animation_delay }}"
                    data-aos-anchor="{{ animation_anchor }}"
                    {%- assign animation_delay = animation_delay | plus: 150 -%}
                  {% endif %}
                >
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endcapture -%}

        {%- capture tabs_navigation -%}
          {{ tabs_navigation }}

          <li class="tabs__link{% if forloop.first %} current{% endif %}"
            data-tabs-link="{{ forloop.index0 }}"
            data-block-id="{{ block.id }}"
            tabindex="0"
            {{ block.shopify_attributes }}>
            <span>{{ block_heading }}</span>
          </li>
        {%- endcapture -%}

        {%- capture tabs -%}
          {{ tabs }}

          <div class="tab{% if enable_tabs == false or forloop.first %} current{% endif -%}" data-tab="{{ forloop.index0 }}">
            {%- comment -%} "Related products" markup {%- endcomment -%}
            {%- if block.type == 'related' and product.collections.size > 0 -%}
              <div id="{{ related_id }}" data-related-products data-limit="{{ fetch_limit }}" data-product-id="{{ product.id }}" {{ block.shopify_attributes }}>
                {%- liquid
                  assign shown = 0
                  assign shown_ids = ','
                  assign current_id = product.id | append: ''

                  capture related_cards
                    comment
                      1) Shopify recommendations, filtered by template / type
                    endcomment
                    if recommendations.performed and recommendations.products_count > 0
                      for rec in recommendations.products
                        if shown >= display_limit
                          break
                        endif

                        assign is_match = false
                        if filter_template == blank and filter_type == blank
                          assign is_match = true
                        endif

                        assign rec_suffix = rec.template_suffix | downcase
                        if filter_template != blank and rec_suffix == filter_template
                          assign is_match = true
                        endif

                        assign rec_type = rec.type | strip | downcase
                        if filter_type != blank and rec_type == filter_type
                          assign is_match = true
                        endif

                        if is_match
                          assign shown = shown | plus: 1
                          assign shown_ids = shown_ids | append: rec.id | append: ','
                          render 'product-card', product: rec, swym_enabled: swym_enabled
                        endif
                      endfor
                    endif

                    comment
                      2) Top up from the backup collection if we're short
                    endcomment
                    if shown < display_limit and fallback_collection != blank
                      for rec in fallback_collection.products limit: 50
                        if shown >= display_limit
                          break
                        endif

                        assign rec_id = rec.id | append: ''
                        assign rec_token = ',' | append: rec_id | append: ','
                        if rec_id == current_id or shown_ids contains rec_token
                          continue
                        endif

                        if rec.available == false and section.settings.fallback_hide_sold_out
                          continue
                        endif

                        assign shown = shown | plus: 1
                        assign shown_ids = shown_ids | append: rec_id | append: ','
                        render 'product-card', product: rec, swym_enabled: swym_enabled
                      endfor
                    endif
                  endcapture
                -%}

                {%- if section.settings.debug_related -%}
                  <!-- RELATED DEBUG | performed: {{ recommendations.performed }} | rec count: {{ recommendations.products_count }} | shown: {{ shown }} | filter suffix: "{{ filter_template }}" | filter type: "{{ filter_type }}" | fallback: "{{ fallback_collection.handle }}" -->
                  {%- for rec in recommendations.products -%}
                    <!-- REC: {{ rec.title | escape }} | type: "{{ rec.type | escape }}" | template suffix: "{{ rec.template_suffix }}" -->
                  {%- endfor -%}
                {%- endif -%}

                {%- if shown > 0 -%}
                  {{ headings_markup }}

                  <div class="collection-grid--custom">
                    <div class="collection-4-grid related-grid lifestyle--product">
                      {{ related_cards }}
                    </div>
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- comment -%} "Recently viewed products" markup {%- endcomment -%}
            {%- if block.type == 'recent' -%}
              {{ headings_markup }}

              {%- render 'products-recently-viewed',
                product: product,
                section_width: section_width,
                limit: product_recently_limit,
                product_recently_minimum: 1,
                block: block,
                columns_mobile: columns_mobile
              -%}
            {%- endif -%}
          </div>
        {%- endcapture -%}
      {%- endfor -%}

      <div class="tabs{% unless show_tabs %} tabs--stacked{% endunless %}" data-tabs-holder>
        {%- if show_tabs -%}
          <div class="tabs__head"
            {% if animations_enabled %}
              data-aos="fade-up"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-delay="{{ animation_delay }}"
              {%- assign animation_delay = animation_delay | plus: 150 -%}
            {% endif %}
          >
            <div class="tabs-scrollbar" data-custom-scrollbar-parent>
              <div class="tabs-scrollbar__holder" data-custom-scrollbar-holder>
                <ul class="tabs__nav {{ type_style }}" data-custom-scrollbar-items>
                  {{ tabs_navigation }}
                </ul>

                <div class="custom-scrollbar" data-custom-scrollbar>
                  <div class="custom-scrollbar__thumb" data-custom-scrollbar-thumb></div>
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}

        <div class="tabs__contents" data-tabs-contents>
          {{ tabs }}
        </div>
      </div>
    {%- else -%}
      {%- render 'no-blocks' -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    {
      "type": "header",
      "content": "Filter related products"
    },
    {
      "type": "paragraph",
      "content": "A recommended product is shown if it matches EITHER field. Leave both blank to show all."
    },
    {
      "type": "text",
      "id": "filter_template_suffix",
      "label": "Product template suffix",
      "info": "e.g. 'general' for product.general.json",
      "default": "general"
    },
    {
      "type": "text",
      "id": "filter_product_type",
      "label": "Product type",
      "default": "Lifestyle Products"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Backup collection",
      "info": "If recommendations don't return enough matching products, the grid is topped up from this collection (e.g. your Lifestyle collection)."
    },
    {
      "type": "checkbox",
      "id": "fallback_hide_sold_out",
      "label": "Skip sold-out products from backup collection",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "debug_related",
      "label": "Debug: output recommendation info as HTML comments",
      "default": false
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "checkbox",
      "id": "swym_enabled",
      "label": "Swym Enabled (on product cards)",
      "default": true
    },
    {
      "type": "range",
      "id": "stacked_max_width",
      "min": 280,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Max card width when stacked (iPad portrait)",
      "default": 480
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "enable_tabs",
      "label": "Enable tabs",
      "default": true
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Recently viewed: products per row on mobile",
      "default": "1",
      "options": [
        { "label": "1", "value": "1" },
        { "label": "2", "value": "2" }
      ]
    },
    {
      "type": "select",
      "label": "Tab heading style",
      "id": "type_style",
      "default": "subheading-text",
      "options": [
        { "label": "Heading", "value": "font-heading" },
        { "label": "Body", "value": "font-body" },
        { "label": "Accent", "value": "subheading-text" }
      ]
    },
    {
      "type": "range",
      "id": "tab_heading_size",
      "label": "Tab heading size",
      "default": 120,
      "min": 100,
      "max": 200,
      "step": 5,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper",
      "options": [
        { "value": "wrapper--full-padded", "label": "Full width padded" },
        { "value": "wrapper", "label": "Page width" }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "related",
      "name": "Related products",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Dynamic recommendations change and improve with time. [Learn more](https://help.shopify.com/en/themes/development/recommended-products)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "You May Also Like"
        },
        {
          "type": "range",
          "id": "product_recommendations_limit",
          "min": 1,
          "max": 6,
          "step": 1,
          "label": "Product limit",
          "info": "Desktop/mobile show up to this many. iPad always caps at 2.",
          "default": 3
        }
      ]
    },
    {
      "type": "recent",
      "name": "Recently viewed products",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Recently viewed"
        },
        {
          "type": "range",
          "id": "product_recently_limit",
          "min": 1,
          "max": 6,
          "step": 1,
          "label": "Product limit",
          "default": 4
        }
      ]
    }
  ]
}
{% endschema %}