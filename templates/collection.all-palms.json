            "overlay_opacity": 100
          }
        },
        "collection_jmQxXz": {
          "type": "collection",
          "settings": {
            "collection": "desert-palms",
            "custom_collection_image": "shopify://shop_images/5_DESERT.jpg",
            "heading": "Vast landscapes, quiet horizons, unexpected beauty — the DESERT PALMS Collection explores the graceful presence of palms within the raw simplicity of the desert. Through open skies, earthy tones, and moments of contrast, these photographs celebrate the remarkable beauty found in one of nature’s most expansive places.",
            "max_width": 480,
            "card_title_override": "",
