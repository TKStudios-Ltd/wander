      "blocks": {
        "collection_LVzNKe": {
          "type": "collection",
          "settings": {
            "collection": "modern-palms",
            "custom_collection_image": "shopify://shop_images/1_MODERN.jpg",
            "heading": "Bold silhouettes, graphic lines, unexpected color — the MODERN PALMS Collection explores the striking geometry found within nature, where oversized fronds reveal their sculptural beauty. Through shape, color, and movement, these photographs celebrate the unexpected artistry of the natural world.",
            "max_width": 490,
            "card_title_override": "",
            "block_text_color": "",
            "bg_color": "rgba(0,0,0,0)",
            "overlay_opacity": 0
          }
        },
        "collection_cYKWnD": {
          "type": "collection",
          "settings": {
            "collection": "island-palms",
            "custom_collection_image": "shopify://shop_images/2_ISLANDS.jpg",
            "heading": "Sweeping horizons and paths to faraway places—the ISLAND PALMS Collection explores the beauty of tropical landscapes, where secluded shores and swaying palms evoke a sense of endless escape. Through airy compositions, subtle color, and relaxed coastal moments, these photographs celebrate the effortless beauty and peaceful rhythm of the natural world.",
            "max_width": 500,
            "card_title_override": "",
            "block_text_color": "",
            "bg_color": "",
            "overlay_opacity": 0
          }
        },
        "collection_KderwA": {
          "type": "collection",
          "settings": {
            "collection": "architectural-palms",
            "custom_collection_image": "shopify://shop_images/3_ARCHITECTURAL.jpg",
            "heading": "Clean lines, organic patterns, unexpected perspective — the ARCHITECTURAL PALMS Collection explores the visual rhythm found within the palm. Through bold angles, layered forms, and balanced compositions, these photographs celebrate the quiet artistry found in nature’s design.",
            "max_width": 500,
            "card_title_override": "",
            "block_text_color": "",
            "bg_color": "",
            "overlay_opacity": 30
          }
        },
        "collection_a87k4e": {
          "type": "collection",
          "settings": {
            "collection": "iconic-palms",
            "custom_collection_image": "shopify://shop_images/4_ICONIC.jpg",
            "heading": "Classic silhouettes, graceful stature, enduring allure — the ICONIC PALMS Collection celebrates the Palm as nature’s star. Standing tall against the sky, these photographs reveal their unique character, elegance, and timeless presence, in the limelight.",
            "max_width": 500,
            "card_title_override": "",
